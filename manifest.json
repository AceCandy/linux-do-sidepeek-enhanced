{
  "manifest_version": 3,
  "name": "Linux.do SidePeek Enhanced",
  "version": "0.7.2",
  "description": "基于 BobDLA/Linux.do SidePeek 的二次开发版：右侧抽屉预览、顶部工具栏、主题缓存与阅读位置恢复。",
  "browser_specific_settings": {
    "gecko": {
      "id": "@linux-do-sidepeek",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://linux.do/t/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://linux.do/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
